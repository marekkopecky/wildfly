<verifications xmlns="http://maven.apache.org/verifications/1.0.0"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://maven.apache.org/verifications/1.0.0 http://maven.apache.org/xsd/verifications-1.0.0.xsd">
<!--
    1) bin/product.conf exists
    2) bin/product.conf has a slot property with a value equal to the value of the
       'full.dist.product.slot' property
    3) jboss-modules.jar must exist
    4) standalone/configuration/standalone.xml must exist
    5) modules/system/layers/base/org/jboss/as/product/${full.dist.product.slot}/module.xml exists
    6) the module.xml above contains to 'org.jboss.eap:wildfly-${latest.ee.artifactid.segment}-feature-pack-product-conf'
    7) the .galleon dir exists
    8) no .galleon/history dir exists
   10) Some verifications around libartemis-native-32.so / libartemis-native-64.so to ensure the server distribution
       contains the -64 variant and does not contain the -32 one.
   11) bin/layers.conf contains layers=microprofile
-->
  <files>
    <file>
      <location>target/${latest.server.output.dir}/bin/product.conf</location>
      <exists>true</exists>
    </file>
    <file>
      <location>target/${latest.server.output.dir}/bin/product.conf</location>
      <contains>slot=${full.dist.product.slot}</contains>
    </file>
    <file>
      <location>target/${latest.server.output.dir}/modules/system/layers/base/org/jboss/as/product/${full.dist.product.slot}/module.xml</location>
      <exists>true</exists>
    </file>
    <file>
      <location>target/${latest.server.output.dir}/modules/system/layers/base/org/jboss/as/product/${full.dist.product.slot}/module.xml</location>
      <contains>org.jboss.eap:wildfly-${latest.ee.artifactid.segment}-feature-pack-product-conf</contains>
    </file>
    <file>
      <location>target/${latest.server.output.dir}/jboss-modules.jar</location>
      <exists>true</exists>
    </file>
    <file>
      <location>target/${latest.server.output.dir}/standalone/configuration/standalone.xml</location>
      <exists>true</exists>
    </file>
    <file>
      <location>target/${latest.server.output.dir}/.galleon</location>
      <exists>true</exists>
    </file>
    <file>
      <location>target/${latest.server.output.dir}/.galleon/history</location>
      <exists>false</exists>
    </file>
    <!-- start of (#10) -->
    <file>
      <location>target/${latest.server.output.dir}/modules/system/layers/base/org/apache/activemq/artemis/journal/main/lib/linux-i686/libartemis-native-32.so</location>
      <exists>false</exists>
    </file>
    <file>
      <location>target/${latest.server.output.dir}/modules/system/layers/base/org/apache/activemq/artemis/journal/main/lib/linux-x86_64/libartemis-native-64.so</location>
      <exists>true</exists>
    </file>
    <!-- end of (#10) -->
    <!-- start of (#11) -->
    <file>
      <location>target/${latest.server.output.dir}/modules/layers.conf</location>
      <contains>layers=microprofile</contains>
    </file>
    <!-- end of (#11) -->
  </files>
</verifications>
